# Copy to .env only if you need to change something. Nothing here is required:
# docker-compose.yml carries the same default, so a fresh clone with no .env
# publishes PostgreSQL on 55432, which is the port every command in the README names.
#
#   cp .env.example .env          Git Bash / sh
#   Copy-Item .env.example .env   PowerShell
#
# .env is ignored by git and .env.example is not, so machine specific values stay
# out of the repository while the list of what can be set stays in it.

# Host port the database container publishes on. Change it when 55432 is taken too;
# then also pass the new port to the application and to the tests, both of which take
# a full JDBC url rather than a port:
#
#   -Dminibank.sql.url=jdbc:postgresql://localhost:55433/minibank
#   -Dminibank.test.sql.url=jdbc:postgresql://localhost:55433/minibank_test
MINIBANK_DB_PORT=55432
