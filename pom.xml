<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cz.vsb.minibank</groupId>
    <artifactId>VIS_project_minibank</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring.boot.version>3.3.4</spring.boot.version>
        <!-- What a bare "mvn exec:java" runs. Override it on the command line for AppSql or
             for the demo runner. -->
        <exec.mainClass>cz.vsb.minibank.App</exec.mainClass>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.17.1</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.3</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot Web (REST + Tomcat) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>${spring.boot.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <!-- The bundled Byte Buddy has to be able to read the running JDK's own class
                 files: mocking a concrete class retransforms java.lang.Object, so a Mockito
                 that trails the current JDK fails every such mock with "Java N is not
                 supported". 5.7.0 topped out at Java 22 and broke the suite on JDK 24. -->
            <version>5.23.0</version>
            <scope>test</scope>
        </dependency>
        <!--
            MockMvc, for the one thing unit tests cannot check: the status code and the
            body bytes an endpoint actually puts on the wire. Just spring-test, not
            spring-boot-starter-test, so nothing here overrides the JUnit and Mockito
            versions pinned above. The version tracks spring-web from the Boot BOM.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <version>6.1.13</version>
            <scope>test</scope>
        </dependency>

    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <!--
                        Through a property, because a literal here wins over -Dexec.mainClass and
                        there is more than one entry point: AppSql and DemoRunner were both
                        unreachable through exec:java, and asking for either silently ran App.
                    -->
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <!-- Publishes each dependency's jar path as a build property, so the
                         surefire argLine below can name mockito-core without hard-coding
                         a local repository path. -->
                    <execution>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <!-- Mockito attached at JVM start: left to itself the inline mock maker
                         attaches its agent while the tests are already running, which JDK 21
                         warns about and a future JDK will refuse by default. The path property
                         comes from dependency:properties above. -->
                    <argLine>-javaagent:${org.mockito:mockito-core:jar}</argLine>
                    <!-- Some tests walk failure paths on purpose and log loudly while they
                         pass; that output belongs in target/surefire-reports, not the
                         console. -->
                    <redirectTestOutputToFile>true</redirectTestOutputToFile>
                    <systemPropertyVariables>
                        <!-- Keep audit output of the whole suite out of the working tree -->
                        <minibank.log.file>${project.build.directory}/minibank-test.log</minibank.log.file>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <configuration>
                    <mainClass>cz.vsb.minibank.ApiApplication</mainClass>
                </configuration>
                <executions>
                    <!--
                        Without spring-boot-starter-parent the repackage goal has no
                        default binding, so mvn package would otherwise produce a plain
                        jar with no dependencies and no Main-Class.
                    -->
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <!-- release rather than source/target: it pins the API surface to the
                         real JDK 17, so a newer build JDK cannot let a 18+ method slip in. -->
                    <release>17</release>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>


        </plugins>
    </build>

</project>